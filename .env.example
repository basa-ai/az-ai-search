# Endpoints (no secrets)
AZURE_SEARCH_ENDPOINT=https://ai-retail-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=retail-docs-index
AZURE_STORAGE_ACCOUNT=retaildemobasa
AZURE_STORAGE_CONTAINER=retaildocs
AZURE_OPENAI_ENDPOINT=https://retail-ai-agent.services.ai.azure.com/openai/v1
# Optional override — defaults to endpoint without /openai/v1
# AZURE_OPENAI_RESOURCE_URL=https://retail-ai-agent.services.ai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini-1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Setup only — indexer/skillset run in Azure and need these stored in their definitions
AZURE_STORAGE_CONNECTION_STRING=
# Embeddings — Foundry project (use resource root, e.g. https://my-resource.services.ai.azure.com)
AZURE_OPENAI_EMBEDDING_RESOURCE_URL=https://srius2023-1305-resource.services.ai.azure.com
AZURE_OPENAI_EMBEDDING_API_KEY=
# Fallback if embedding-specific vars are not set
AZURE_OPENAI_API_KEY=

# Required for API search queries (use query key or admin key from AI Search → Keys)
AZURE_SEARCH_QUERY_KEY=
# AZURE_SEARCH_ADMIN_KEY=

# Tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_CHUNKS=5
LLM_TOP_K_CHUNKS=5
LLM_SNIPPET_CHARS=450
MAX_HISTORY_TURNS=10
API_TIMEOUT_SECONDS=180
CHAT_MAX_COMPLETION_TOKENS=4096

# Indexer schedule (setup only). Azure runs incremental indexing on this interval.
# Set to 0 to disable automatic runs (manual: python -m setup.run_indexer).
INDEXER_SCHEDULE_HOURS=5
